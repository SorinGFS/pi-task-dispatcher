{
  "name": "pi-task-dispatcher",
  "version": "3.0.0",
  "description": "Run configurable Pi worker models as supervised, observable, resumable jobs.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "delegation",
    "subagent",
    "model-routing"
  ],
  "author": "SorinGFS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soringfs/pi-task-dispatcher.git"
  },
  "homepage": "https://github.com/soringfs/pi-task-dispatcher#readme",
  "bugs": {
    "url": "https://github.com/soringfs/pi-task-dispatcher/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test:gate": "node tests/gate-probe.mjs",
    "test:fake-rpc": "node tests/fake-rpc-check.mjs",
    "check": "node tests/static-check.mjs && node tests/fake-rpc-check.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/task-dispatcher.ts"
    ]
  },
  "files": [
    "extensions",
    "tests",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
